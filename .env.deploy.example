# Tencent Cloud TCR registry host and full image path.
DOCKER_REGISTRY=ccr.ccs.tencentyun.com
DOCKER_IMAGE_NAME=ccr.ccs.tencentyun.com/tsuz/tsuz-api-main-test
DOCKER_REGISTRY_USERNAME=__TCR_ACCOUNT_ID__

# Deployment target values are GitHub Environment Variables; keep real values out of this file.
DEPLOY_HOST=__DEPLOY_HOST__
DEPLOY_PORT=22
DEPLOY_USER=__DEPLOY_USER__
DEPLOY_PATH=/opt/tsuz-api/runtime

# The deployment server checks out release tags here and builds linux/amd64 images.
DEPLOY_REPO_PATH=/opt/tsuz-api/source
DOCKER_BUILD_PLATFORM=linux/amd64

# Immutable image/application version tag.
APP_VERSION=test-v1.0.0

# Container names and host ports.
CONTAINER_NAME=auth-service
NGINX_CONTAINER_NAME=auth-service-nginx
APP_PORT=8000
NGINX_PORT=8080

# Deployment environment, explicit Compose project, and shared Docker network.
# COMPOSE_PROJECT_NAME is configured as a GitHub Environment Variable and is
# shared by the independent Init and Deploy workflows for this environment.
APP_ENV=test
COMPOSE_PROJECT_NAME=tsuz-api-test
DOCKER_NETWORK_NAME=tsuz-api-main-test

# Runtime service settings.
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
SERVICE_NAME=auth-service
API_PREFIX=/api

# Infrastructure connection. Use GitHub Secrets for real values.
DATABASE_URL=postgresql+psycopg://auth_user:__POSTGRES_PASSWORD__@test-postgres:5432/auth
DB_SSLMODE=disable

# Infrastructure settings used by the independent manual init.yml workflow.
# Configure POSTGRES_PASSWORD as a GitHub Environment Secret, not as a Variable.
POSTGRES_CONTAINER_NAME=test-postgres
POSTGRES_DB=auth
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_PORT=5432
INIT_HEALTH_RETRIES=30
INIT_HEALTH_INTERVAL_SECONDS=2

REDIS_URL=redis://test-redis:6379/0
REDIS_KEY_PREFIX=auth:test:
REDIS_CONTAINER_NAME=test-redis
REDIS_PORT=6379

# QQ website OAuth credentials are injected from GitHub Environment Secrets.
APP_ID=__QQ_APP_ID__
APP_KEY=__QQ_APP_KEY__
QQ_REDIRECT_URI=https://test-api.tusz.online/auth/qq/callback
QQ_TICKET_REDIRECT_URI=https://test.tusz.online/login
QQ_AUTHORIZE_URL=https://graph.qq.com/oauth2.0/authorize
QQ_TOKEN_URL=https://graph.qq.com/oauth2.0/token
QQ_OPENID_URL=https://graph.qq.com/oauth2.0/me
QQ_USER_INFO_URL=https://graph.qq.com/user/get_user_info
QQ_STATE_PREFIX=tsuz:main:test:qq:state:
QQ_TICKET_PREFIX=tsuz:main:test:qq:ticket:
QQ_STATE_TTL_SECONDS=300
QQ_TICKET_TTL_SECONDS=60
QQ_HTTP_TIMEOUT_SECONDS=10

# JWT common config.
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=backend-api
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# python-main signs tokens. Keep this secret in GitHub Environment Secrets for real deploys.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
REFRESH_TOKEN_ROTATE=true
REFRESH_TOKEN_PREFIX=auth:test:refresh:
TOKEN_BLACKLIST_PREFIX=auth:test:blacklist:jti:
SESSION_PREFIX=auth:test:session:

# Tencent Cloud CAM long-term credentials. Inject real values through deployment Secrets.
TENCENTCLOUD_SECRET_ID=__TENCENTCLOUD_SECRET_ID__
TENCENTCLOUD_SECRET_KEY=__TENCENTCLOUD_SECRET_KEY__
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_SES_ENDPOINT=ses.tencentcloudapi.com

EMAIL_FROM_ADDRESS=noreply@notify.tusz.online
EMAIL_FROM_NAME=tusz.online
EMAIL_TEMPLATE_ID=57044
EMAIL_SUBJECT=邮箱验证码
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_INTERVAL_SECONDS=60
EMAIL_API_TIMEOUT_SECONDS=10
EMAIL_CHALLENGE_PREFIX=auth:test:email:challenge:
EMAIL_SEND_LIMIT_PREFIX=auth:test:email:send:
EMAIL_IP_SEND_LIMIT_PREFIX=auth:test:email:ip-send:
EMAIL_SEND_LIMIT_PER_HOUR=10
EMAIL_IP_SEND_LIMIT_PER_MINUTE=5
# Use the private address/CIDR of the trusted reverse proxy only.
TRUSTED_PROXY_IPS=127.0.0.1,::1

CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true

OPENAPI_ENABLED=false
DOCS_ENABLED=false
REDOC_ENABLED=false

# Normal immutable-tag Deploy uses these GitHub Environment Secrets only for its
# one-shot seed command. Do not copy them into the persistent runtime .env file.
SEED_ADMIN_EMAIL=__SEED_ADMIN_EMAIL__
SEED_ADMIN_PASSWORD=__SEED_ADMIN_PASSWORD__

# Optional deploy workflow health checks.
DEPLOY_HEALTH_RETRIES=30
DEPLOY_HEALTH_INTERVAL_SECONDS=5
DEPLOY_PUBLIC_HEALTH_URL=https://api.example.com/health
