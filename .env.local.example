# Local Docker development configuration copied to .env by `pdm run init`.
APP_ENV=test
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30

SERVICE_NAME=tusz-main-api
API_PREFIX=/api

DATABASE_URL=postgresql+psycopg://test_user:test_password@postgres:5432/test_auth
DB_SSLMODE=disable
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=auth:test:

# QQ website OAuth test application. Inject APP_KEY through a local secret store.
APP_ID=
APP_KEY=
QQ_REDIRECT_URI=https://test-api.tusz.online/auth/qq/callback
QQ_TICKET_REDIRECT_URI=https://test.tusz.online/login
QQ_AUTHORIZE_URL=https://graph.qq.com/oauth2.0/authorize
QQ_TOKEN_URL=https://graph.qq.com/oauth2.0/token
QQ_OPENID_URL=https://graph.qq.com/oauth2.0/me
QQ_USER_INFO_URL=https://graph.qq.com/user/get_user_info
QQ_STATE_PREFIX=tsuz:main:test:qq:state:
QQ_TICKET_PREFIX=tsuz:main:test:qq:ticket:
QQ_STATE_TTL_SECONDS=300
QQ_TICKET_TTL_SECONDS=60
QQ_HTTP_TIMEOUT_SECONDS=10

JWT_ALGORITHM=RS256
JWT_ISSUER=tusz-main-api-test
JWT_AUDIENCE=backend-api-test
JWT_PRIVATE_KEY="__JWT_PRIVATE_KEY__"
JWT_PUBLIC_KEY="__JWT_PUBLIC_KEY__"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
REFRESH_TOKEN_ROTATE=true
REFRESH_TOKEN_PREFIX=auth:test:refresh:
TOKEN_BLACKLIST_PREFIX=auth:test:blacklist:jti:
SESSION_PREFIX=auth:test:session:

# Local-only bootstrap credentials. Change these before running `pdm run init`.
# Production/test deployments use GitHub Environment Secrets instead.
SEED_ADMIN_EMAIL=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME

CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
OPENAPI_ENABLED=true
DOCS_ENABLED=true
REDOC_ENABLED=true
